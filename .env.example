# Anthropic API Key (required for AI contract/cheque extraction)
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Server port (default: 3000)
PORT=3000

# Email reminders — Gmail example (use App Password, not your main password)
# To create a Gmail App Password: Google Account → Security → 2FA → App Passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@gmail.com
EMAIL_PASS=xxxx-xxxx-xxxx-xxxx
EMAIL_RECIPIENT=your@gmail.com

# Optional: Google Drive integration
# Create at https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_API_KEY=
